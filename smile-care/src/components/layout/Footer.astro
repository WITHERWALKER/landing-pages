---
import { footerGroups, socialLinks } from "@/data/site";
import { ArrowRight } from "@lucide/astro";
---

<footer
  class="bg-black text-white min-h-[60dvh] rounded-4xl m-4 overflow-hidden relative"
>
  <div class="mx-auto px-6 sm:max-w-400 w-full pt-16 pb-[15vw] min-w-0">
    <section
      class="flex flex-col md:flex-row md:items-start md:justify-between gap-10 min-w-0 w-full"
    >
      <aside class="w-full md:w-1/3 min-w-0" data-animate="fade-up">
        <p
          class="text-3xl md:text-4xl font-semibold text-white leading-tight mb-2"
        >
          Novedades y sonrisas<br />de SmileCare
        </p>
        <form
          action="#"
          method="post"
          class="mt-8 w-full max-w-md"
          aria-label="Suscripción al boletín"
        >
          <label for="email-input" class="sr-only">Tu correo electrónico</label>
          <div class="flex items-center justify-between gap-3">
            <input
              type="email"
              id="email-input"
              name="email"
              placeholder="Tu correo"
              required
              class="bg-transparent border-b border-white/20 text-sm py-2 flex-1 min-w-0 focus:outline-none focus:border-white/60 transition-colors placeholder:text-white/40"
              autocomplete="email"
            />
            <button
              type="submit"
              class="text-white/60 hover:text-white transition-colors shrink-0"
              aria-label="Suscribirme al boletín"
            >
              <ArrowRight />
            </button>
          </div>
        </form>
      </aside>

      <div
        class="flex flex-wrap gap-8 md:gap-20 lg:gap-24 text-sm md:text-base text-white/70 md:flex-1 md:justify-end min-w-0"
        data-animate-stagger
      >
        {
          footerGroups.map((group) => (
            <nav aria-label={group.label} data-animate-item>
              <ul class="flex flex-col gap-4">
                {group.links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      class="hover:text-white transition-colors text-lg"
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          ))
        }
        <nav aria-label="Redes sociales" data-animate-item>
          <ul class="flex flex-col gap-3">
            {
              socialLinks.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="hover:text-white transition-colors text-lg"
                    rel="noopener noreferrer"
                    target="_blank"
                  >
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </section>

    <div
      class="absolute inset-x-0 bottom-0 overflow-hidden text-center pointer-events-none"
      data-animate="fade-up"
    >
      <span
        class="block whitespace-nowrap font-bold text-neutral-800 leading-[0.85] tracking-tighter select-none text-[clamp(5rem,18.5vw,25rem)] -mb-[0.08em]"
        aria-hidden="true"
      >
        Smile&bull;Care
      </span>
    </div>
  </div>
</footer>
