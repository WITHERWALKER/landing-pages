---
import CTAButton from "@/components/ui/CTAButton.astro";
import SectionEyebrow from "@/components/ui/SectionEyebrow.astro";
import { Image } from "astro:assets";
import { worksContent } from "@/data/site";
import alineacionImg from "@/assets/images/alineacion.png";
import sonrisaCardImg from "@/assets/images/sonrisa-sana.png";
---

<section
  id="works"
  class="py-16 md:py-24 bg-light-green mx-4 rounded-4xl"
  aria-labelledby="works-heading"
>
  <div class="mx-auto px-6 md:px-10 sm:max-w-400">
    <header
      class="flex flex-col md:flex-row md:items-start md:justify-between mt-16 mb-32 gap-6"
    >
      <div
        data-animate="fade-up"
        class="flex flex-col items-center justify-center gap-3 py-1"
      >
        <SectionEyebrow label="Casos reales" />
      </div>

      <h2
        id="works-heading"
        class="text-3xl md:text-5xl font-semibold tracking-tight text-balance text-right"
        data-animate="fade-up"
      >
        Resultados Reales de <br /> Nuestros Tratamientos
      </h2>
    </header>

    <div class="flex flex-col md:flex-row gap-8 md:gap-12">
      <div
        class="w-full grid grid-cols-1 sm:grid-cols-3 gap-4 md:gap-6"
        data-animate-stagger
      >
        <article data-animate="fade-up" class="flex flex-col justify-between">
          <div>
            <p
              class="text-base md:text-lg max-w-110 text-pretty font-medium text-neutral-600 leading-relaxed mb-6"
            >
              Contamos con un equipo de dentistas experimentados que se preocupa
              por hacerte sentir cómodo y bienvenido en cada visita.
            </p>

            <CTAButton href="#services">Reservar Cita</CTAButton>
          </div>

          <figure
            class="flex items-center gap-3 mt-8"
            aria-label="Pacientes felices"
          >
            <div class="flex -space-x-10">
              {
                worksContent.members.map((member) => (
                  <span
                    class:list={[
                      "size-28 rounded-full border-2 border-light-green flex items-center justify-center text-xs font-bold text-dark",
                      member.tone,
                    ]}
                  >
                    {member.initials}
                  </span>
                ))
              }
            </div>

            <figcaption>
              <p class="text-xl font-semibold text-dark">10k+ Pacientes</p>
              <p class="text-xl text-dark/60">Felices</p>
            </figcaption>
          </figure>
        </article>

        <figure
          data-animate-item
          class="group relative overflow-hidden rounded-2xl aspect-16/10 sm:aspect-3/4"
        >
          <Image
            src={alineacionImg}
            alt="Tratamiento de alineación dental con ortodoncia"
            class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-102"
            widths={[480, 800]}
            sizes="(min-width: 640px) 33vw, 100vw"
            loading="lazy"
            decoding="async"
          />

          <div
            class="absolute inset-0 bg-linear-to-t from-black/80 via-black/5 to-transparent"
            aria-hidden="true"
          >
          </div>

          <figcaption class="absolute inset-x-0 bottom-0 p-4 md:p-5">
            <h3 class="text-base md:text-2xl font-semibold text-white">
              Alineación Dental
            </h3>

            <p
              class="mt-1 text-sm md:text-base max-w-96 text-pretty text-neutral-400"
            >
              Corrige la posición de tus dientes y mejora tu sonrisa de forma
              cómoda y efectiva.
            </p>
          </figcaption>
        </figure>

        <figure
          data-animate-item
          class="group relative overflow-hidden rounded-2xl aspect-16/10 sm:aspect-3/4"
        >
          <Image
            src={sonrisaCardImg}
            alt="Sonrisa sana y luminosa después de un diseño de sonrisa"
            class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-102"
            widths={[480, 800]}
            sizes="(min-width: 640px) 33vw, 100vw"
            loading="lazy"
            decoding="async"
          />
          <div
            class="absolute inset-0 bg-linear-to-t from-black/80 via-black/5 to-transparent"
            aria-hidden="true"
          >
          </div>

          <figcaption class="absolute inset-x-0 bottom-0 p-4 md:p-5">
            <h3 class="text-base md:text-2xl font-semibold text-white">
              Diseño de Sonrisa
            </h3>

            <p
              class="mt-1 text-sm md:text-base max-w-96 text-pretty text-neutral-400"
            >
              Transforma tu sonrisa con un tratamiento personalizado que realza
              tu belleza natural.
            </p>
          </figcaption>
        </figure>
      </div>
    </div>
  </div>
</section>
