---
import { ArrowRight } from "@lucide/astro";

interface Props {
  as?: "button" | "a";
  href?: string;

  variant?: Variant;
  size?: Size;
  type?: "button" | "submit" | "reset";

  withIcon?: boolean;
  styles?: string;
}

const {
  as = "button",
  href,

  variant = "primary",
  size = "md",
  type = "button",

  withIcon = true,
  styles = "",
} = Astro.props as Props;

type Variant = keyof typeof variants;
type Size = keyof typeof sizes;

const base =
  "inline-flex items-center justify-center gap-3 rounded-full font-medium transition-colors focus:outline-none focus:ring-2 focus:ring-primary/40 cursor-pointer";

const variants = {
  primary: "bg-primary text-bg",
  secondary: "bg-[#eff6dd] text-black",
  outline: "border border-black/40 text-black",
} as const;

const sizes = {
  sm: "px-3 py-2 text-sm",
  md: "px-4 py-3 text-base",
  lg: "px-6 py-4 text-lg",
} as const;
---

{
  as === "a" ? (
    <a href={href} class={`${base} ${variants[variant]} ${sizes[size]}`}>
      <slot />
      {withIcon && <ArrowRight class="font-light size-4" />}
    </a>
  ) : (
    <button
      type={type}
      class={`${base} ${variants[variant]} ${sizes[size]} ${styles}`}
    >
      <slot />
      {withIcon && <ArrowRight class="font-light size-4" />}
    </button>
  )
}
