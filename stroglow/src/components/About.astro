---
import { CircleCheckBig } from "@lucide/astro";
import Button from "./Button.astro";

const infoAbout: {
  title: string;
  description: string;
}[] = [
  {
    title: "Our Mission",
    description:
      "To make premium skincare accessible to everyone, promoting healthy, glowing skin through transparency, nature-driven formulations.",
  },
  {
    title: "Our Vision",
    description:
      "To inspire confidence by offering skin solutions that are gentle, effective, and powered by clean ingredients crafted for every skin type.",
  },
];
---

<section class="bg-bg py-24">
  <div class="container-page flex max-h-144 gap-16">
    <article class="flex flex-col justify-between flex-1 text-primary">
      <header>
        <h2 class="text-6xl leading-17">
          We blend science and nature to reveal your glowing skin
        </h2>
        <p class="text-lg mt-6 text-balance">
          At Skincare, we create dermatologist-approved, naturally enriched
          formulas designed to nourish, repair, and enhance your skin.
        </p>
      </header>

      <section class="flex flex-col gap-6 my-14">
        {
          infoAbout.map((item) => (
            <article class="max-w-2xl">
              <div class="flex gap-3 items-center text-lg font-medium">
                <CircleCheckBig />
                <h4>{item.title}</h4>
              </div>

              <p>{item.description}</p>
            </article>
          ))
        }
      </section>

      <footer class="flex gap-8 items-center">
        <Button>Explore More</Button>

        <span class="underline"> 100% Satisfaction guaranteed </span>
      </footer>
    </article>

    <aside class="grid grid-cols-2 grid-rows-2 gap-3 flex-1">
      <img
        src="https://d-unas.com/es/wp-content/uploads/2025/03/Limpieza-Facial-2.png"
        alt=""
        class="bg-amber-300"
      />
      <img
        src="https://img.freepik.com/fotos-premium/concepto-belleza-hermosa-mujer-modelo-crema-hidratante-cara_231834-3354.jpg"
        alt=""
        class="bg-amber-500 col-start-1 row-start-2"
      />
      <img
        src="https://hips.hearstapps.com/hmg-prod/images/cream-lotion-and-face-of-black-woman-with-beauty-royalty-free-image-1730795921.jpg?crop=0.669xw:1.00xh;0.215xw,0&resize=1200:*"
        alt=""
        class="bg-amber-800 row-span-2 col-start-2 row-start-1"
      />
    </aside>
  </div>
</section>

<style>
  aside img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 1rem;
  }
</style>
