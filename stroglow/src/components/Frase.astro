---
import Button from "./Button.astro";
---

<section class="container-page pt-32 text-center text-primary">
  <p class="flex justify-center">
    Formulated with
    <img
      src="hoja-tropical.png"
      alt=""
      class="w-full h-full max-w-32 rotate-160"
    />
    dermatologist-approved
  </p>
  <p class="flex justify-center">
    ingredients our skincare
    <img
      src="https://png.pngtree.com/png-clipart/20250513/original/pngtree-green-liquid-soap-dispenser-with-hygiene-cleanliness-and-smooth-application-png-image_20954610.png"
      alt=""
      class="w-full h-full max-w-20 rotate-y-180 rotate-32"
    />
    line delivers gentle,
  </p>
  <p class="">effective care with us.</p>

  <footer class="flex justify-center gap-4 my-20">
    <Button> Shop Now </Button>

    <button
      class="flex items-center gap-3 px-6 py-3 rounded-full text-black border border-black/40"
    >
      Key Benefits
    </button>
  </footer>
</section>

<style>
  p {
    font-size: 4.5rem;
    line-height: 1.2;
    font-weight: 300;
  }
</style>
