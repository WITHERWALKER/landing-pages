---
import { Plus } from "@lucide/astro";
import Button from "./Button.astro";

const questions: {
  question: string;
}[] = [
  {
    question: "Are your products natural or chemical-base?",
  },
  {
    question: "How long will it take to see results?",
  },
  {
    question: "Which product is best for my skin type?",
  },
  {
    question: "Which age group are your products suitable for?",
  },
  {
    question: "The expense windows adapted sir. Wrong widen drawn.",
  },
];
---

<section class="container-page py-24">
  <header class="flex flex-col gap-4 text-center text-primary pb-24">
    <h2 class="text-5xl font-medium">Got Questions? We've Got Answers</h2>
    <p class="text-balance">
      Rejuvenate with soothing therapies crafted to bring harmony, peace, and
      natural balance.
    </p>
  </header>

  <div class="grid grid-cols-3 gap-16">
    <aside
      class="flex flex-col justify-between items-center max-w-fit bg-primary text-white rounded-2xl p-14"
    >
      <img
        src="https://img.icons8.com/?size=112&id=6651&format=png&color=ffffff"
        alt=""
      />

      <div class="flex flex-col gap-4 text-center">
        <h3 class="text-4xl font-medium text-balance">
          Do you have more questions?
        </h3>

        <p class="text-sm font-light text-balance">
          Have more questions? We're here to help with answers, guidance, and
          tips for your skincare needs.
        </p>
      </div>

      <Button withIcon={false} styles="bg-white text-primary w-full">
        Direct Mail
      </Button>
    </aside>

    <div class="grid col-span-2 gap-4" data-accordion>
      {
        questions.map((quest, index) => (
          <details
            open={index === 0}
            class={`group bg-[#f5f5f5] rounded-2xl p-6 transition`}
          >
            <summary class="flex justify-between items-center cursor-pointer list-none text-lg font-medium">
              {quest.question}

              <span class="transition-transform group-open:rotate-45 text-xl">
                <Plus />
              </span>
            </summary>
            <p class="mt-4 text-black/70 leading-relaxed text-balance">
              Lorem ipsum dolor sit amet consectetur adipisicing elit.
              Asperiores officia ea voluptatem. Laboriosam magni corrupti eos
              minus, quod corporis earum vel eaque placeat iure repellendus, ad
              possimus eveniet exercitationem sequi. Lorem ipsum dolor sit amet
              consectetur adipisicing elit. Quaerat, voluptatibus.
            </p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<script is:inline>
  document.querySelectorAll("[data-accordion]").forEach((accordion) => {
    accordion.addEventListener(
      "toggle",
      (e) => {
        if (e.target.tagName === "DETAILS" && e.target.open) {
          accordion.querySelectorAll("details").forEach((item) => {
            if (item !== e.target) item.removeAttribute("open");
          });
        }
      },
      true,
    );
  });
</script>
