---
import { ArrowRight, ShoppingBasket } from "@lucide/astro";
import Button from "./Button.astro";
---

<header class="bg-bg pt-8">
  <div
    class="container-page flex justify-between py-2.5 px-3 rounded-full items-center bg-white"
  >
    <div class="flex items-center gap-1">
      <img src="/favicon.svg" alt="Logo" class="size-8" />
      <h1 class="text-2xl">STROGLOW</h1>
    </div>

    <nav class="">
      <ul class="flex gap-8 text-black">
        <li><a href="#">Home</a></li>
        <li><a href="#">Shop</a></li>
        <li><a href="#">About</a></li>
        <li><a href="#">Contact</a></li>
        <li><a href="#">FAQ</a></li>
      </ul>
    </nav>

    <div class="flex items-center gap-6">
      <button class="bg-[#eff5de] relative p-3 rounded-full">
        <span
          class="absolute -top-1 -right-1 bg-primary text-bg rounded-full size-5 flex items-center justify-center text-xs"
          >3</span
        >
        <ShoppingBasket />
      </button>

      <Button> Shop Now </Button>
    </div>
  </div>
</header>
